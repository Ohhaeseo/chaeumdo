POSTGRES_PASSWORD=replace-with-a-long-random-password
DOMAIN=chaeummdo.example.com

# Password reset mail (docs/DEPLOYMENT.md). Without MAIL_HOST, "이메일로 찾기" answers 503.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@chaeummdo.example.com
# Change whenever the terms or the privacy policy (frontend/src/legal.ts) change.
# TERMS_VERSION=draft-2026-11

# Optional. Backups (scripts/backup.sh) go to BACKUP_DIR on this server and are kept for BACKUP_KEEP_DAYS.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14

# Optional. Map tiles and place search for a public service (docs/DEPLOYMENT.md). Empty keeps
# OpenStreetMap and Photon, whose public servers are meant for development only.
# Tile URLs are raster XYZ templates with {z}, {x} and {y}; place search must be Photon-compatible.
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© Example Maps
# MAP_ATTRIBUTION_URL=https://tiles.example.com/copyright
# PLACE_SEARCH_URL=https://photon.example.com/api
# PLACE_SEARCH_ATTRIBUTION=검색: Photon · © OpenStreetMap contributors
# PLACE_SEARCH_ATTRIBUTION_URL=https://photon.example.com
